// =============================================================================
// SUGGESTED Prisma models for the Website → Portal application intake.
//
// Append these to the Portal's prisma/schema.prisma (they're SQLite-safe:
// strings instead of enums, JSON stored as String), then run:
//     npx prisma db push     # or: prisma migrate dev
//
// This is an INTAKE table for applications submitted via the marketing website.
// Your existing funnel/ops can read from it and promote applicants into your
// primary applicant model — or, if you prefer, map the ingest route directly
// onto your existing model instead of adding these.
// =============================================================================

model ContributorApplication {
  id            String  @id @default(cuid())
  source        String  @default("valtaris-website")
  opportunitySlug String?

  // Personal
  fullName        String
  preferredName   String?
  email           String
  phone           String?
  country         String?
  state           String?
  city            String?
  timezone        String?
  preferredContact String?
  linkedin        String?
  portfolio       String?
  website         String?

  // Education
  highestEducation String?
  fieldOfStudy     String?
  institution      String?
  graduationYear   String?

  // Experience & skills (JSON strings)
  hasPriorExperience Boolean @default(false)
  yearsExperience    String?
  experienceEntries  String  @default("[]")
  skills             String  @default("[]")
  customSkills       String  @default("[]")

  // Availability
  hoursPerWeek      String?
  availabilitySlots String  @default("[]")
  startAvailability String?
  openToFuture      Boolean @default(true)

  // Resume — resumePath is a private storage key; never serve it publicly.
  resumeFileName String?
  resumePath     String?

  // Essay
  essay   String?
  essayQ1 String?
  essayQ2 String?
  essayQ3 String?
  essayQ4 String?

  // Consent
  consentDataProcessing Boolean @default(false)
  consentContact        Boolean @default(false)

  status String @default("NEW") // NEW | PROFILE_REVIEW | ... (your funnel statuses)

  languages ContributorApplicationLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([opportunitySlug])
}

model ContributorApplicationLanguage {
  id            String  @id @default(cuid())
  applicationId String
  languageName  String
  proficiency   String
  speaking      String?
  reading       String?
  writing       String?
  listening     String?
  yearsExposure String?
  learnedIn     String?
  dialectLocale String?
  isStrongest   Boolean @default(false)

  application ContributorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([languageName])
}
