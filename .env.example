# Copy to .env.local for local dev.

# Where the Website forwards submitted applications. The Portal owns applicant
# storage (assessments, login, qualifications). Leave unset in local dev to use
# the ./_applications fallback. See docs/portal-integration.md for the contract.
# PORTAL_APPLICATION_ENDPOINT="https://portal.valtaris.ai/api/ingest/applications"

# Shared secret sent to the Portal as `Authorization: Bearer <token>`.
# PORTAL_INGEST_TOKEN="change-me"
